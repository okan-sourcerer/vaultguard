{
  "manifest_version": 3,
  "name": "VaultGuard",
  "version": "1.0.0",
  "description": "Fills passwords from your VaultGuard vault, via the VaultGuard desktop service.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VaultGuard"
  },
  "background": {
    "service_worker": "background.js"
  }
}