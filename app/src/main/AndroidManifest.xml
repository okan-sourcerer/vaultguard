<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Keeps the process running long enough to clear the clipboard. A cached process is
        frozen within seconds on Android 12+, and a deferred WorkManager job is batched into
        maintenance windows, so neither can honour a thirty-second window.
        shortService needs no type-specific permission.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Optional: without it the service still runs, its notification is just not shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VaultGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VaultGuard">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VaultGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".autofill.VaultAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <receiver
            android:name=".autofill.AutofillNeverReceiver"
            android:exported="false" />

        <service
            android:name=".security.ClipboardClearService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.VaultGuard" />

        <activity
            android:name=".autofill.AutofillSaveActivity"
            android:exported="false"
            android:theme="@style/Theme.VaultGuard" />

        <!--
            Exported because the system Settings app launches it, by name, from the gear
            beside VaultGuard in the autofill service list (#53). It holds no data and
            forwards straight to MainActivity, which still gates on the master password.
        -->
        <activity
            android:name=".autofill.AutofillSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.VaultGuard.Invisible" />
    </application>

</manifest>