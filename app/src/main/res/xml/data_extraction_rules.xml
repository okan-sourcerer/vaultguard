<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for API 31+. See backup_rules.xml for API 30 and below.

    The vault is excluded from both cloud backup and device transfer (finding #2).

    vault.db is encrypted with a random passphrase stored in vault_secure_prefs, which is
    itself encrypted by an Android Keystore master key. Keystore material leaves the
    device in neither flow. Copying the database and preferences without it produces a
    vault nothing can ever decrypt — and, before this was fixed, one that DatabaseModule
    would then delete on sight (finding #1).

    device-transfer is excluded for the same reason as cloud-backup: the Keystore key does
    not migrate between devices, so a transferred vault is just as unreadable.

    The app's own encrypted export is the supported way to move a vault.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="vault_secure_prefs.xml" />
        <exclude domain="sharedpref" path="biometric_prefs.xml" />
        <exclude domain="sharedpref" path="sync_prefs.xml" />
        <exclude domain="sharedpref" path="autofill_dismissed_prefs.xml" />
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="vault_secure_prefs.xml" />
        <exclude domain="sharedpref" path="biometric_prefs.xml" />
        <exclude domain="sharedpref" path="sync_prefs.xml" />
        <exclude domain="sharedpref" path="autofill_dismissed_prefs.xml" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
